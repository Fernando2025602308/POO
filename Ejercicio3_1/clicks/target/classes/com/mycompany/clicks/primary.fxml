<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="107.0" prefWidth="193.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.clicks.PrimaryController">
   <children>
      <Label fx:id="lbl" text="Contador de clicks" />
      <Button fx:id="btn" onAction="#btn_click" text="Contar" />
      <TextField fx:id="txt" />
      <Label fx:id="lbl1" layoutX="58.0" layoutY="30.0" text="Esperar tiempo" />
      <Button fx:id="btn1" layoutX="80.0" layoutY="68.0" onAction="#btnEsperar_click" text="10 seg" />
      <ProgressBar fx:id="tiempo" progress="0.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
